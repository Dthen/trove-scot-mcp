    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "canmore_id": {
          "type": "integer",
          "description": "The stable Canmore ID of the site (e.g. 52068 for Edinburgh\nCastle). This is the number at the end of a trove.scot/place/{id} URL."
